# Copy this file to .env and adjust the values before deploying.

# Port the server listens on
PORT=3000

# Secret used to sign admin session cookies — change this to a long random
# string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# Credentials for the FIRST admin account, only used the first time the
# database is seeded (npm run seed / postinstall). Change the password from
# the back office (/admin/account) right after the first login.
ADMIN_EMAIL=admin@globalimpact.com
ADMIN_PASSWORD=ChangeMoi123!
