<%
/* Reusable drag-and-drop image picker.
   Locals: name (input name, required), existingUrl (current image, optional),
   required (boolean, optional), hint (optional override text). */
var _dzUid = name + '-' + Math.random().toString(36).slice(2, 8);
var _dzExisting = typeof existingUrl !== 'undefined' && existingUrl ? publicPath(existingUrl) : '';
%>
<div class="dropzone <%= _dzExisting ? '' : 'is-empty' %>" data-dropzone data-original="<%= _dzExisting %>">
  <input type="file" name="<%= name %>" accept="image/*" class="dropzone__input" id="dz-<%= _dzUid %>" <%= (typeof required !== 'undefined' && required) ? 'required' : '' %> />
  <div class="dropzone__preview" data-role="preview">
    <% if (_dzExisting) { %><img src="<%= _dzExisting %>" alt="" /><% } %>
  </div>
  <label for="dz-<%= _dzUid %>" class="dropzone__body">
    <span class="dropzone__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 16V4M12 4l-4.5 4.5M12 4l4.5 4.5" />
        <path d="M4 16.5V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5" />
      </svg>
    </span>
    <span class="dropzone__title">Glissez une image ici</span>
    <span class="dropzone__sub"><%= typeof hint !== 'undefined' ? hint : 'ou cliquez pour parcourir — JPG, PNG, WebP, GIF (8 Mo max)' %></span>
    <span class="dropzone__filename" data-role="filename" hidden></span>
  </label>
  <button type="button" class="dropzone__clear" data-role="clear" hidden aria-label="Retirer le fichier sélectionné">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>
