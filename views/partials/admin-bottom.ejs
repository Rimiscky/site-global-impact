    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.snow.min.css" rel="stylesheet" />
<script>
  // Turns every <div data-richtext="fieldName"> into a Quill editor and
  // syncs its HTML into a hidden input named fieldName on submit.
  document.querySelectorAll('[data-richtext]').forEach(function (el) {
    var fieldName = el.getAttribute('data-richtext');
    var hidden = document.querySelector('input[type=hidden][name="' + fieldName + '"], textarea[name="' + fieldName + '"][data-richtext-source]');
    var initial = hidden ? hidden.value : '';
    var editorDiv = document.createElement('div');
    editorDiv.className = 'rt-editor';
    editorDiv.innerHTML = initial;
    el.appendChild(editorDiv);
    var quill = new Quill(editorDiv, { theme: 'snow' });
    var form = el.closest('form');
    if (form) {
      form.addEventListener('submit', function () {
        if (hidden) hidden.value = quill.root.innerHTML;
      });
    }
  });

  // Confirm destructive actions
  document.querySelectorAll('[data-confirm]').forEach(function (el) {
    el.addEventListener('submit', function (e) {
      if (!confirm(el.getAttribute('data-confirm'))) e.preventDefault();
    });
  });
</script>
</body>
</html>
