<%- include('../partials/admin-top', { title: 'Pages légales' }) %>

<div class="card">
  <h2>Pages légales</h2>
  <p class="hint">Politique de confidentialité, conditions d'utilisation, conformité des données.</p>
  <table class="list">
    <thead><tr><th>Page</th><th>Dernière modification</th><th></th></tr></thead>
    <tbody>
      <% pages.forEach(function(p) { %>
        <tr>
          <td><%= p.title %></td>
          <td><%= p.updated_at %></td>
          <td><a class="btn btn-sm" href="/admin/legal/<%= p.slug %>">Modifier</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-bottom') %>
