<%- include('../partials/admin-top', { title: 'Messages reçus' }) %>

<div class="card">
  <h2>Formulaire de contact (<%= messages.length %>)</h2>
  <% if (!messages.length) { %>
    <p class="hint">Aucun message pour le moment.</p>
  <% } else { %>
    <table class="list">
      <thead><tr><th>Date</th><th>Contact</th><th>Sujet</th><th>Message</th><th></th></tr></thead>
      <tbody>
        <% messages.forEach(function (m) { %>
          <tr>
            <td style="white-space:nowrap"><%= m.created_at %> <% if (!m.is_read) { %><br><span class="badge badge-off">nouveau</span><% } %></td>
            <td>
              <strong><%= m.name %></strong><br>
              <a href="mailto:<%= m.email %>"><%= m.email %></a>
              <% if (m.org) { %><br><span class="hint"><%= m.org %></span><% } %>
              <% if (m.phone) { %><br><span class="hint"><%= m.phone %></span><% } %>
            </td>
            <td><%= m.topic %></td>
            <td style="max-width:320px;white-space:pre-wrap"><%= m.message %></td>
            <td class="row-actions">
              <% if (!m.is_read) { %>
                <form method="post" action="/admin/messages/<%= m.id %>/read"><button type="submit" class="btn btn-sm">Marquer lu</button></form>
              <% } %>
              <form method="post" action="/admin/messages/<%= m.id %>/delete" data-confirm="Supprimer ce message ?">
                <button type="submit" class="btn btn-sm btn-danger">Suppr.</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/admin-bottom') %>
