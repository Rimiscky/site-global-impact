<%- include('../partials/admin-top', { title: 'Tableau de bord' }) %>

<div class="grid-stats">
  <div class="stat-box"><strong><%= counts.domains %></strong><span>Domaines de formation</span></div>
  <div class="stat-box"><strong><%= counts.programs %></strong><span>Programmes</span></div>
  <div class="stat-box"><strong><%= counts.team %></strong><span>Membres de l'équipe</span></div>
  <div class="stat-box"><strong><%= counts.clients %></strong><span>Références clients</span></div>
  <div class="stat-box"><strong><%= counts.gallery %></strong><span>Photos réalisations</span></div>
  <div class="stat-box"><strong><%= counts.faq %></strong><span>Questions FAQ</span></div>
  <div class="stat-box"><strong><%= counts.unreadMessages %></strong><span>Messages non lus / <%= counts.messages %></span></div>
</div>

<div class="card">
  <h2>Bienvenue 👋</h2>
  <p class="hint">
    Utilisez le menu à gauche pour modifier les textes et images de chaque page du site,
    gérer le catalogue de formations, l'équipe, les références clients, la galerie de réalisations
    et la FAQ — sans toucher au code. Les modifications sont visibles immédiatement sur le site public.
  </p>
</div>

<div class="card">
  <h2>Derniers messages reçus</h2>
  <% if (!recentMessages.length) { %>
    <p class="hint">Aucun message pour le moment.</p>
  <% } else { %>
    <table class="list">
      <thead><tr><th>Date</th><th>Nom</th><th>Sujet</th><th></th></tr></thead>
      <tbody>
        <% recentMessages.forEach(function(m) { %>
          <tr>
            <td><%= m.created_at %></td>
            <td><%= m.name %> <% if (!m.is_read) { %><span class="badge badge-off">nouveau</span><% } %></td>
            <td><%= m.topic %></td>
            <td><a href="/admin/messages" class="btn-link">Voir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/admin-bottom') %>
