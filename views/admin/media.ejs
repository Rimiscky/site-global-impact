<%- include('../partials/admin-top', { title: 'Médiathèque' }) %>

<div class="card">
  <h2>Ajouter une image</h2>
  <form method="post" action="/admin/media" enctype="multipart/form-data">
    <%- include('../partials/dropzone', { name: 'file', required: true, hint: 'ou cliquez pour parcourir — JPG, PNG, WebP, GIF, SVG (8 Mo max)' }) %>
    <button type="submit" class="btn btn-primary" style="margin-top:14px">Envoyer</button>
  </form>
</div>

<div class="card">
  <h2>Toutes les images (<%= items.length %>)</h2>
  <% if (!items.length) { %>
    <p class="hint">Aucune image envoyée pour le moment. Les images de démarrage restent disponibles dans /assets et /logo.</p>
  <% } else { %>
    <div class="media-grid">
      <% items.forEach(function (m) { %>
        <figure>
          <img src="/uploads/<%= m.filename %>" alt="<%= m.original_name %>" />
          <figcaption>
            <code title="/uploads/<%= m.filename %>">/uploads/<%= m.filename %></code>
            <form method="post" action="/admin/media/<%= m.id %>/delete" data-confirm="Supprimer cette image ?">
              <button type="submit" class="btn-link" style="color:#C0392B">Suppr.</button>
            </form>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/admin-bottom') %>
