<!doctype html>
<html lang="fr">

<head>
  <script>
    (function () {
      var t = localStorage.getItem('gic-theme') ||
        (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#184E6C" />

  <title><%= settings.site_title %> — <%= settings.site_tagline %></title>
  <meta name="description" content="<%= settings.meta_description %>" />
  <meta name="keywords"
    content="Global Impact Consulting, GIC, formation, coaching, conseil stratégique, leadership, management, Congo, développement personnel, RH, QHSE" />
  <meta name="author" content="Global Impact Consulting" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="https://globalimpactconsulting.com/" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Global Impact Consulting" />
  <meta property="og:title" content="Global Impact Consulting — Révéler le potentiel, accélérer la croissance" />
  <meta property="og:description"
    content="Cabinet d'accompagnement professionnel : formation, coaching, conseil stratégique et événements à forte valeur ajoutée." />
  <meta property="og:url" content="https://globalimpactconsulting.com/" />
  <meta property="og:image" content="https://globalimpactconsulting.com/assets/og-cover.jpg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Global Impact Consulting" />
  <meta name="twitter:description"
    content="Formation, coaching et conseil stratégique. Un impact durable, humain et mesurable." />

  <!-- Favicon (inline SVG) -->
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23184E6C'/%3E%3Ctext x='50' y='64' font-family='Inter,Arial' font-size='44' font-weight='800' text-anchor='middle' fill='%23D4A574'%3EG%3C/text%3E%3C/svg%3E" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&display=swap"
    rel="stylesheet" />

  <!-- Structured data (SEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Global Impact Consulting",
    "alternateName": "GIC",
    "description": "Cabinet d'accompagnement professionnel spécialisé dans la formation, le coaching, le conseil stratégique, les études et l'organisation d'événements à forte valeur ajoutée.",
    "areaServed": "Congo",
    "url": "https://globalimpactconsulting.com/",
    "logo": "https://globalimpactconsulting.com/assets/logo.svg",
    "founder": {"@type": "Person", "name": "Karel NTSIKA", "jobTitle": "Directeur Exécutif"},
    "sameAs": [],
    "serviceType": ["Formation", "Coaching", "Conseil stratégique", "Études", "Événementiel"]
  }
  </script>

  <link rel="stylesheet" href="styles.css" />
</head>

<body>
  <!-- Loader -->
  <div class="loader" id="loader" aria-hidden="true">
    <div class="loader__brand">
      <span class="loader__word" data-split>Global Impact Consulting</span>
    </div>
    <div class="loader__progress"><span id="loaderBar"></span></div>
  </div>

  <!-- Scroll progress -->
  <div class="scroll-progress" aria-hidden="true"><span id="scrollBar"></span></div>

  <!-- Custom cursor -->
  <div class="cursor" id="cursor" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

  <!-- Navigation -->
  <header class="nav" id="nav">
    <a href="#top" class="nav__logo" aria-label="Global Impact Consulting - Accueil">
      <img src="<%= settings.site_logo %>" alt="Global Impact Consulting" height="40"
        style="display:block;height:40px;width:auto;" />
    </a>

    <nav class="nav__menu" id="navMenu" aria-label="Menu principal">
      <a href="qui-sommes-nous.html" data-nav>Qui sommes-nous</a>
      <a href="#activities" data-nav>Nos activités</a>
      <a href="formation.html" data-nav>Formations</a>
      <a href="#realisations" data-nav>Réalisations</a>
      <a href="#faq" data-nav>FAQ</a>
      <a href="contact.html" data-nav class="nav__cta">Nous contacter <span aria-hidden="true">→</span></a>
    </nav>

    <button class="theme-toggle" id="themeToggle" aria-label="Basculer le mode sombre">
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>

    <button class="nav__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <main id="top">

    <!-- HERO -->
    <section class="hero" id="hero" data-parallax-scene>
      <div class="hero__bg" aria-hidden="true">
        <div class="blob blob--1" data-parallax="0.12"></div>
        <div class="blob blob--2" data-parallax="-0.18"></div>
        <div class="grid-pattern" data-parallax="0.06"></div>
      </div>

      <!-- Floating photos - parallax collage -->
      <div class="hero__collage" aria-hidden="true">
        <figure class="hero__photo hero__photo--a" data-parallax="0.18" data-tilt>
          <div class="hero__photo-inner">
            <img src="assets/young-african-man-presenting-at-conference-2026-01-08-06-26-54-utc.jpg" alt=""
              loading="eager" decoding="async" fetchpriority="high" />
          </div>
          <figcaption><span>Conférence</span></figcaption>
        </figure>
        <figure class="hero__photo hero__photo--b" data-parallax="-0.24" data-tilt>
          <div class="hero__photo-inner">
            <img src="assets/businesswoman-raising-hand-during-business-seminar-2026-03-25-00-50-12-utc.jpg" alt=""
              loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Séminaire</span></figcaption>
        </figure>
        <figure class="hero__photo hero__photo--c" data-parallax="0.32" data-tilt>
          <div class="hero__photo-inner">
            <img src="assets/multiracial-young-creative-people-in-modern-office-2026-03-18-13-28-56-utc.jpg" alt=""
              loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Équipe</span></figcaption>
        </figure>
      </div>

      <div class="hero__inner">
        <div class="eyebrow fade-up">
          <span class="dot"></span> <%= blocks.hero_eyebrow %>
        </div>

        <h1 class="hero__title">
          <span class="line"><span data-reveal><%= blocks.hero_title_line1 %></span></span>
          <span class="line"><span data-reveal><%- blocks.hero_title_line2_html %></span></span>
        </h1>

        <p class="hero__lead fade-up" style="--d:.2s">
          <%= blocks.hero_lead %>
        </p>

        <div class="hero__cta fade-up" style="--d:.35s">
          <a href="#contact" class="btn btn--primary magnetic">
            <span><%= blocks.hero_cta_primary %></span>
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#services" class="btn btn--ghost magnetic"><%= blocks.hero_cta_secondary %></a>
        </div>

        <div class="hero__stats fade-up" style="--d:.5s">
          <% blocks.hero_stats.forEach(function (s) { %>
            <div class="stat">
              <span class="stat__num"><span data-count="<%= s.num %>">0</span><%= s.suffix %></span>
              <span class="stat__label"><%= s.label %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <a href="#about" class="hero__scroll" aria-label="Faire défiler">
        <span></span>
        <small>scroll</small>
      </a>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Leadership</span><span>•</span>
        <span>Développement personnel</span><span>•</span>
        <span>Management stratégique</span><span>•</span>
        <span>Commercial</span><span>•</span>
        <span>Business</span><span>•</span>
        <span>RH</span><span>•</span>
        <span>QHSE</span><span>•</span>
        <span>Leadership</span><span>•</span>
        <span>Développement personnel</span><span>•</span>
        <span>Management stratégique</span><span>•</span>
        <span>Commercial</span><span>•</span>
        <span>Business</span><span>•</span>
        <span>RH</span><span>•</span>
        <span>QHSE</span><span>•</span>
      </div>
    </div>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="container about__grid">
        <div class="about__media" data-parallax-scene>
          <figure class="about__photo" data-parallax="0.06">
            <img src="assets/happy-mature-businesswoman-talking-to-group-of-sem-2026-03-24-00-27-24-utc.jpg"
              alt="Accompagnement en séminaire — Global Impact Consulting" loading="lazy" decoding="async" />
            <div class="about__photo-overlay"></div>
            <div class="about__photo-stat">
              <strong><%= blocks.about_photo_stat_num %></strong>
              <span><%= blocks.about_photo_stat_label %></span>
            </div>
          </figure>

          <div class="about__card" data-parallax="-0.08">
            <div class="about__card-head">
              <span>Directeur Exécutif</span>
              <span class="about__badge">Le mot</span>
            </div>
            <blockquote>
              « <%= blocks.about_quote %> »
            </blockquote>
            <div class="about__signature">
              <strong><%= blocks.about_quote_author %></strong>
              <span><%= blocks.about_quote_role %></span>
            </div>
          </div>
          <div class="about__glow" data-parallax="-0.12" aria-hidden="true"></div>
        </div>

        <div class="about__text">
          <div class="section-head reveal">
            <span class="section-kicker"><%= blocks.about_kicker %></span>
            <h2 class="section-title"><%- blocks.about_title_html %></h2>
          </div>

          <p class="reveal"><%- blocks.about_text_1 %></p>
          <p class="reveal"><%- blocks.about_text_2 %></p>

          <p class="pillars__label reveal" style="--d:.15s">Nos principes fondateurs</p>
          <ul class="pillars">
            <% blocks.pillars.forEach(function (p, i) { %>
              <li class="reveal" style="--d:<%= (0.20 + i * 0.07).toFixed(2) %>s">
                <span class="pillars__icon"><%= p.letter %></span>
                <div>
                  <h3><%= p.title %></h3>
                  <p><%= p.text %></p>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="clients" id="clients">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker"><%= blocks.clients_kicker %></span>
          <h2 class="section-title"><%- blocks.clients_title_html %></h2>
          <p class="section-sub"><%= blocks.clients_desc %></p>
        </div>
      </div>

      <div class="clients__strip">
        <div class="clients__track">
          <!-- Set 1 -->
          <% [1, 2].forEach(function () { %>
            <% clients.forEach(function (c) { %>
              <div class="client-logo"><img src="<%= c.logo %>" alt="<%= c.name %>" /></div>
            <% }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- NOS ACTIVITÉS -->
    <section class="activities" id="activities">
      <div class="container">
        <div class="activities__intro reveal">
          <div class="section-head" style="margin-bottom:20px">
            <span class="section-kicker"><%= blocks.activities_kicker %></span>
            <h2 class="section-title"><%- blocks.activities_title_html %></h2>
          </div>
          <em class="activities__tagline"><%= blocks.activities_tagline %></em>
          <p class="activities__desc"><%= blocks.activities_desc %></p>
        </div>

        <div class="activities__grid">

          <% activities.forEach(function (a, i) { %>
            <article class="act-card reveal" style="--d:<%= (i * 0.07).toFixed(2) %>s">
              <div class="act-card__icon"><%- a.icon_svg %></div>
              <h3><%= a.title %></h3>
              <p><%= a.text %></p>
            </article>
          <% }) %>

        </div>
      </div>
    </section>


    <!-- MÉTHODE G.I.M.P.A.C.T -->
    <section class="method" id="method">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Signature pédagogique</span>
          <h2 class="section-title">La méthodologie <em>G.I.M.P.A.C.T</em></h2>
          <p class="section-sub">Un parcours en 7 étapes conçu pour transformer la connaissance en résultat.</p>
        </div>

        <div class="method__grid">
          <article class="method__card reveal" style="--d:0s">
            <span class="method__letter">G</span>
            <h3>Diagnostic Global</h3>
            <p>Analyse du contexte réel du participant ou de l'entreprise.</p>
          </article>
          <article class="method__card reveal" style="--d:.06s">
            <span class="method__letter">I</span>
            <h3>Immersion</h3>
            <p>Compréhension des enjeux et partage d'expériences terrain.</p>
          </article>
          <article class="method__card reveal" style="--d:.12s">
            <span class="method__letter">M</span>
            <h3>Modélisation</h3>
            <p>Apport méthodologique et outils structurants.</p>
          </article>
          <article class="method__card reveal" style="--d:.18s">
            <span class="method__letter">P</span>
            <h3>Pratique</h3>
            <p>Ateliers, simulations et cas concrets.</p>
          </article>
          <article class="method__card reveal" style="--d:.24s">
            <span class="method__letter">A</span>
            <h3>Application</h3>
            <p>Construction d'un plan d'action personnalisé.</p>
          </article>
          <article class="method__card reveal" style="--d:.30s">
            <span class="method__letter">C</span>
            <h3>Coaching</h3>
            <p>Accompagnement post-formation continu.</p>
          </article>
          <article class="method__card method__card--full reveal" style="--d:.36s">
            <span class="method__letter">T</span>
            <h3>Transformation</h3>
            <p>Mesure des résultats et impact organisationnel durable.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker"><%= blocks.services_kicker %></span>
          <h2 class="section-title"><%- blocks.services_title_html %></h2>
          <p class="section-sub"><%= blocks.services_desc %></p>
        </div>

        <div class="services__tabs" role="tablist">
          <% domains.forEach(function (d, i) { %>
            <button class="tab <%= i === 0 ? "active" : "" %>" data-tab="<%= d.slug %>" role="tab" <%= i === 0 ? "aria-selected=\"true\"" : "" %>><%= d.name %></button>
          <% }) %>
        </div>

        <div class="services__panels">
          <% domains.forEach(function (d, i) { %>
            <div class="panel <%= i === 0 ? "active" : "" %>" data-panel="<%= d.slug %>" role="tabpanel" <%= i === 0 ? "" : "hidden" %>>
              <div class="cards">
                <% (programsByDomain[d.slug] || []).forEach(function (p, j) { %>
                  <article class="card"><span class="card__num"><%= String(j + 1).padStart(2, "0") %></span>
                    <h3><%= p.title %></h3>
                    <p><%= p.description %></p>
                  </article>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- LEVELS / PARALLAX -->
    <section class="levels" id="levels" data-parallax-scene>
      <div class="levels__bg" aria-hidden="true">
        <div class="levels__shape" data-parallax="0.15"></div>
      </div>

      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Parcours de formation</span>
          <h2 class="section-title section-title--light">3 niveaux, <em>une progression</em> cohérente.</h2>
          <p class="section-sub section-sub--light">De l'acquisition des fondamentaux à la transformation stratégique.
          </p>
        </div>

        <div class="levels__grid">
          <article class="level reveal" style="--d:0s">
            <header>
              <span class="level__tag">Niveau 1</span>
              <h3>Essentiel</h3>
              <small>Opérationnel</small>
            </header>
            <ul>
              <li>Acquisition des fondamentaux</li>
              <li>Outils immédiatement applicables</li>
              <li>Approche pratique orientée terrain</li>
            </ul>
            <footer>Collaborateurs, jeunes managers, entrepreneurs débutants</footer>
          </article>

          <article class="level reveal level--featured" style="--d:.1s">
            <header>
              <span class="level__tag">Niveau 2</span>
              <h3>Avancé</h3>
              <small>Managerial</small>
            </header>
            <ul>
              <li>Approfondissement stratégique</li>
              <li>Études de cas réels</li>
              <li>Mise en situation professionnelle</li>
            </ul>
            <footer>Managers, responsables d'équipe, cadres</footer>
          </article>

          <article class="level reveal" style="--d:.2s">
            <header>
              <span class="level__tag">Niveau 3</span>
              <h3>Executive</h3>
              <small>Dirigeants</small>
            </header>
            <ul>
              <li>Vision stratégique et transformation</li>
              <li>Coaching collectif</li>
              <li>Problématiques réelles d'entreprise</li>
            </ul>
            <footer>Dirigeants, directeurs, hauts potentiels</footer>
          </article>
        </div>
      </div>
    </section>

    <!-- RÉALISATIONS -->
    <section class="realisations" id="realisations" data-parallax-scene>
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker"><%= blocks.realisations_kicker %></span>
          <h2 class="section-title"><%- blocks.realisations_title_html %></h2>
          <p class="section-sub"><%= blocks.realisations_desc %></p>
        </div>

        <!-- Filtres -->
        <% const catLabels = { seminaire: 'Séminaires', formation: 'Formations', conference: 'Conférences', coaching: 'Coaching' }; %>
        <div class="gallery__filters reveal" role="tablist">
          <button class="gfilter active" data-filter="all" role="tab" aria-selected="true">
            Tout <span><%= gallery.length %></span>
          </button>
          <% Object.keys(catLabels).forEach(function (cat) { %>
            <% const n = gallery.filter(g => g.category === cat).length; %>
            <% if (n > 0) { %>
              <button class="gfilter" data-filter="<%= cat %>" role="tab"><%= catLabels[cat] %> <span><%= n %></span></button>
            <% } %>
          <% }) %>
        </div>

        <!-- Featured video -->
        <div class="featured-video reveal" data-parallax-scene>
          <div class="featured-video__media">
            <img src="assets/diversity-people-talk-international-conference-par-2026-03-18-12-01-06-utc.jpg"
              alt="Conférence internationale Global Impact Consulting" loading="lazy" decoding="async"
              data-parallax="0.12" />
            <button class="featured-video__play magnetic" type="button" aria-label="Lire la vidéo de présentation">
              <span class="featured-video__pulse" aria-hidden="true"></span>
              <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
            </button>
          </div>
          <div class="featured-video__caption">
            <span class="featured-video__tag">Édition 2024</span>
            <h3>Forum International du Leadership</h3>
            <p>250+ dirigeants · 3 jours · 12 intervenants</p>
          </div>
        </div>

        <!-- Galerie mosaïque -->
        <div class="gallery" id="gallery">
          <% gallery.forEach(function (g) { %>
            <figure class="gallery__item <%= g.size === "wide" ? "gallery__item--wide" : g.size === "tall" ? "gallery__item--tall" : "" %>" data-cat="<%= g.category %>" data-reveal-img>
              <img src="<%= g.image %>" alt="<%= g.title %>" loading="lazy" decoding="async" />
              <figcaption class="gallery__cap">
                <span class="gallery__tag"><%= g.tag %></span>
                <h3><%= g.title %></h3>
                <p><%= g.subtitle %></p>
              </figcaption>
              <button class="gallery__zoom" aria-label="Agrandir l'image">
                <svg viewBox="0 0 24 24" width="18" height="18">
                  <path d="M7 7h4M7 7v4M17 7h-4M17 7v4M7 17h4M7 17v-4M17 17h-4M17 17v-4" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" fill="none" />
                </svg>
              </button>
            </figure>
          <% }) %>
        </div>

        <!-- Stats chiffres clés -->
        <div class="realisations__stats reveal">
          <% blocks.realisations_stats.forEach(function (st) { %>
            <div class="rstat">
              <span class="rstat__num"><span data-count="<%= st.num %>">0</span><%= st.suffix %></span>
              <span class="rstat__label"><%= st.label %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </section>


    <!-- FAQ -->
    <section class="faq" id="faq">
      <div class="container faq__grid">
        <div class="section-head reveal">
          <span class="section-kicker">FAQ</span>
          <h2 class="section-title">Questions <em>fréquentes</em>.</h2>
          <p class="section-sub">Tout ce qu'il faut savoir avant de démarrer une collaboration.</p>
        </div>

        <div class="faq__list">
          <% faq.forEach(function (f, i) { %>
            <details class="faq__item reveal" style="--d:<%= (i * 0.06).toFixed(2) %>s">
              <summary><span><%= f.question %></span><span class="faq__plus"></span></summary>
              <div class="faq__body"><%- f.answer %></div>
            </details>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact" data-parallax-scene>
      <div class="contact__bg" aria-hidden="true">
        <div class="blob blob--3" data-parallax="0.1"></div>
        <div class="blob blob--4" data-parallax="-0.14"></div>
      </div>

      <div class="container contact__grid">
        <div class="contact__intro">
          <div class="section-head reveal">
            <span class="section-kicker section-kicker--light"><%= blocks.contact_kicker %></span>
            <h2 class="section-title section-title--light"><%- blocks.contact_title_html %></h2>
            <p class="section-sub section-sub--light"><%= blocks.contact_desc %></p>
          </div>

          <ul class="contact__info reveal">
            <li>
              <span class="contact__label">Email</span>
              <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a>
            </li>
            <li>
              <span class="contact__label">Téléphone</span>
              <a href="tel:<%= settings.contact_phone.replace(/\s+/g,'') %>"><%= settings.contact_phone %></a><% if (settings.contact_phone_2) { %> · <a href="tel:<%= settings.contact_phone_2.replace(/\s+/g,'') %>"><%= settings.contact_phone_2 %></a><% } %>
            </li>
            <li>
              <span class="contact__label">Bureau</span>
              <span><%= settings.contact_address.replace(/\n/g, ', ') %></span>
            </li>
          </ul>
        </div>

        <form class="contact__form reveal" id="contactForm" novalidate>
          <div class="field">
            <input type="text" id="fName" name="name" required autocomplete="name" placeholder=" " />
            <label for="fName">Nom complet</label>
          </div>
          <div class="field">
            <input type="email" id="fEmail" name="email" required autocomplete="email" placeholder=" " />
            <label for="fEmail">Email professionnel</label>
          </div>
          <div class="field">
            <input type="text" id="fOrg" name="org" autocomplete="organization" placeholder=" " />
            <label for="fOrg">Organisation</label>
          </div>
          <div class="field">
            <select id="fTopic" name="topic" required>
              <option value="" disabled selected></option>
              <option>Leadership</option>
              <option>Développement personnel</option>
              <option>Management stratégique</option>
              <option>Commercial</option>
              <option>Business</option>
              <option>RH</option>
              <option>QHSE</option>
              <option>Autre</option>
            </select>
            <label for="fTopic">Domaine d'intérêt</label>
          </div>
          <div class="field field--full">
            <textarea id="fMsg" name="message" rows="4" required placeholder=" "></textarea>
            <label for="fMsg">Votre message</label>
          </div>
          <button type="submit" class="btn btn--primary btn--full magnetic">
            <span>Envoyer ma demande</span>
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </button>
          <p class="contact__note" id="formNote" aria-live="polite"></p>
        </form>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="container footer__grid">
      <div class="footer__brand">
        <img src="<%= settings.site_logo %>" alt="<%= settings.site_title %>"
          style="height:48px;width:auto;display:block;margin-bottom:12px;" />
        <p><%= blocks.footer_tagline %></p>
      </div>
      <nav class="footer__nav" aria-label="Navigation footer">
        <h4>Navigation</h4>
        <a href="#about">Qui sommes-nous</a>
        <a href="#activities">Nos activités</a>
        <a href="formation.html">Formations</a>
        <a href="#method">Méthode</a>
        <a href="#levels">Parcours</a>
        <a href="#realisations">Réalisations</a>
        <a href="#faq">FAQ</a>
      </nav>
      <nav class="footer__nav" aria-label="Domaines">
        <h4>Expertises</h4>
        <a href="#services">Leadership</a>
        <a href="#services">Management</a>
        <a href="#services">Commercial & Business</a>
        <a href="#services">RH</a>
        <a href="#services">QHSE</a>
      </nav>
      <nav class="footer__nav" aria-label="Informations légales">
        <h4>Légal</h4>
        <a href="politique-confidentialite.html">Politique de confidentialité</a>
        <a href="conditions-utilisation.html">Conditions d'utilisation</a>
        <a href="conformite-donnees.html">Conformité des données</a>
      </nav>
      <div class="footer__nav">
        <h4>Contact</h4>
        <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a>
        <a href="tel:<%= settings.contact_phone.replace(/\s+/g,'') %>"><%= settings.contact_phone %></a>
        <% if (settings.contact_phone_2) { %><a href="tel:<%= settings.contact_phone_2.replace(/\s+/g,'') %>"><%= settings.contact_phone_2 %></a><% } %>
        <span><%= settings.contact_address.split('\n')[0] %></span>
      </div>
    </div>
    <div class="footer__bottom container">
      <small>© <span id="year"></span> <%= settings.site_title %> — Tous droits réservés.</small>
      <small>Design par <a href="https://www.rimiscky.fr" target="_blank">Rimiscky</a></small>
    </div>
  </footer>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visualisation de la photo" hidden>
    <button class="lightbox__close" id="lbClose" aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
      </svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" id="lbPrev" aria-label="Image précédente">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          fill="none" />
      </svg>
    </button>
    <button class="lightbox__nav lightbox__nav--next" id="lbNext" aria-label="Image suivante">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          fill="none" />
      </svg>
    </button>
    <figure class="lightbox__stage">
      <img id="lbImg" src="" alt="" />
      <figcaption id="lbCap"></figcaption>
    </figure>
    <div class="lightbox__counter" id="lbCounter"></div>
  </div>

  <!-- Video modal -->
  <div class="video-modal" id="videoModal" role="dialog" aria-modal="true" aria-label="Vidéo" hidden>
    <button class="lightbox__close" id="vmClose" aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
      </svg>
    </button>
    <div class="video-modal__stage">
      <video id="vmPlayer" controls playsinline preload="none">
        <source src="" type="video/mp4" />
        <p>Votre navigateur ne supporte pas la lecture vidéo.</p>
      </video>
      <div class="video-modal__placeholder">
        <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
          <path d="M15 10l-4 4V6l4 4z" fill="currentColor" />
        </svg>
        <h3>Vidéo bientôt disponible</h3>
        <p>Ajoutez votre fichier vidéo dans <code>assets/video-presentation.mp4</code> pour l'activer ici.</p>
      </div>
    </div>
  </div>

  <script src="script.js" defer></script>
</body>

</html>