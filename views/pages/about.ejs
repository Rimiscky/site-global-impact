<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#184E6C" />

  <title>Qui sommes-nous — <%= settings.site_title %></title>
  <meta name="description" content="Découvrez Global Impact Consulting : notre mission, notre vision, nos valeurs RIRE, notre histoire et l'équipe qui accompagne entreprises et particuliers vers une performance durable." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://globalimpactconsulting.com/qui-sommes-nous.html" />

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23184E6C'/%3E%3Ctext x='50' y='64' font-family='Inter,Arial' font-size='44' font-weight='800' text-anchor='middle' fill='%23D4A574'%3EG%3C/text%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="styles.css" />
  <!-- Theme applied immediately to avoid flash -->
  <script>
    (function(){var t=localStorage.getItem("gic-theme"),d=t?t==="dark":window.matchMedia("(prefers-color-scheme: dark)").matches;if(d)document.documentElement.setAttribute("data-theme","dark");})();
  </script>


  <style>
    /* ── About page extras ─────────────────────────── */

    /* Hero */
    .about-hero {
      padding: clamp(140px,18vw,210px) 0 clamp(80px,10vw,120px);
      background: var(--ink);
      position: relative; overflow: hidden;
    }
    .about-hero__bg { position: absolute; inset: 0; pointer-events: none; }
    .about-hero__bg .blob {
      position: absolute; border-radius: 50%;
      filter: blur(90px); opacity: .15;
    }
    .about-hero__bg .blob--1 { width: 560px; height: 560px; background: var(--gold); top: -160px; right: -120px; }
    .about-hero__bg .blob--2 { width: 360px; height: 360px; background: var(--gold-2); bottom: -80px; left: 5%; }
    .about-hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
    .about-hero .eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 13px; font-weight: 600; letter-spacing: .1em;
      text-transform: uppercase; color: var(--gold-2); margin-bottom: 28px;
    }
    .about-hero .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
    .about-hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(44px,6.5vw,82px);
      font-weight: 300; line-height: 1.06;
      letter-spacing: -0.03em; color: var(--bg); margin: 0;
    }
    .about-hero h1 em { color: var(--gold-2); font-style: italic; }
    .about-hero__quote {
      border-left: 2px solid var(--gold);
      padding-left: 28px; margin: 0;
    }
    .about-hero__quote p {
      font-family: var(--font-serif);
      font-size: clamp(18px,2vw,22px);
      font-style: italic; font-weight: 300;
      color: rgba(221,236,246,.92);
      line-height: 1.55; margin: 0 0 20px;
    }
    .about-hero__quote cite {
      display: flex; flex-direction: column; gap: 2px;
      font-style: normal;
    }
    .about-hero__quote cite strong { font-size: 15px; font-weight: 700; color: var(--bg); }
    .about-hero__quote cite span { font-size: 13px; color: var(--gold-2); }
    @media (max-width: 860px) {
      .about-hero__inner { grid-template-columns: 1fr; gap: 48px; }
    }

    /* MVA — Mission Vision Ambition */
    .mva { padding: clamp(80px,10vw,130px) 0; background: var(--bg); }
    .mva__grid {
      display: grid; grid-template-columns: repeat(3,1fr);
      gap: clamp(16px,2vw,24px); margin-top: clamp(48px,6vw,72px);
    }
    .mva__card {
      padding: clamp(32px,4vw,48px) clamp(28px,3vw,40px);
      border-radius: var(--radius-lg);
      position: relative; overflow: hidden;
      transition: transform .45s var(--ease), box-shadow .45s var(--ease);
    }
    .mva__card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
    .mva__card--mission { background: var(--ink); color: var(--bg); }
    .mva__card--vision  { background: var(--gold-soft); }
    .mva__card--ambition{ background: var(--paper); border: 1px solid var(--line-soft); }
    .mva__tag {
      font-size: 11px; font-weight: 700; letter-spacing: .14em;
      text-transform: uppercase; margin-bottom: 20px; display: block;
    }
    .mva__card--mission .mva__tag { color: var(--gold-2); }
    .mva__card--vision  .mva__tag { color: var(--gold); }
    .mva__card--ambition .mva__tag { color: var(--gold); }
    .mva__icon {
      width: 52px; height: 52px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 24px;
    }
    .mva__card--mission .mva__icon { background: rgba(255,255,255,.08); color: var(--gold-2); }
    .mva__card--vision  .mva__icon { background: rgba(201,162,95,.2); color: var(--gold); }
    .mva__card--ambition .mva__icon { background: var(--gold-soft); color: var(--gold); }
    .mva__card h3 {
      font-family: var(--font-serif);
      font-size: clamp(20px,2.2vw,26px);
      font-weight: 400; letter-spacing: -0.02em; margin: 0 0 16px; line-height: 1.2;
    }
    .mva__card--mission h3 { color: var(--bg); }
    .mva__card p { font-size: 15px; line-height: 1.7; margin: 0; }
    .mva__card--mission p { color: rgba(221,236,246,.65); }
    .mva__card--vision  p { color: var(--ink-3); }
    .mva__card--ambition p { color: var(--muted); }
    @media (max-width: 860px) { .mva__grid { grid-template-columns: 1fr; } }

    /* Histoire */
    .histoire { padding: clamp(80px,10vw,130px) 0; background: var(--bg-2); }
    .histoire__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .histoire__photo {
      position: relative; border-radius: var(--radius-lg); overflow: hidden;
      aspect-ratio: 4/5;
    }
    .histoire__photo img { width: 100%; height: 100%; object-fit: cover; }
    .histoire__photo-badge {
      position: absolute; bottom: 28px; left: 28px;
      background: var(--ink); color: var(--bg);
      padding: 16px 22px; border-radius: 14px;
      border-left: 3px solid var(--gold);
    }
    .histoire__photo-badge strong { display: block; font-size: 28px; font-weight: 800; color: var(--gold-2); line-height: 1; }
    .histoire__photo-badge span { font-size: 13px; color: rgba(221,236,246,.82); margin-top: 4px; display: block; }
    .histoire__timeline { display: flex; flex-direction: column; gap: 0; }
    .histoire__step {
      display: grid; grid-template-columns: 72px 1fr;
      gap: 0 24px; padding: 32px 0;
      border-bottom: 1px solid var(--line-soft);
      position: relative;
    }
    .histoire__step:last-child { border-bottom: none; }
    .histoire__year {
      font-family: var(--font-serif);
      font-size: 13px; font-weight: 600;
      color: var(--gold); letter-spacing: .04em;
      padding-top: 4px; white-space: nowrap;
    }
    .histoire__step h3 { font-size: 17px; font-weight: 700; margin: 0 0 8px; letter-spacing: -0.01em; }
    .histoire__step p { font-size: 14px; color: var(--muted); margin: 0; line-height: 1.7; }
    @media (max-width: 860px) {
      .histoire__grid { grid-template-columns: 1fr; }
      .histoire__photo { aspect-ratio: 16/9; max-height: 360px; }
    }

    /* Valeurs RIRE */
    .valeurs { padding: clamp(80px,10vw,130px) 0; background: var(--ink); }
    .valeurs .section-kicker { color: var(--gold-2); }
    .valeurs .section-title { color: var(--bg); }
    .valeurs .section-title em { color: var(--gold-2); }
    .valeurs .section-sub { color: rgba(221,236,246,.78); }
    .rire__grid {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: clamp(14px,2vw,20px); margin-top: clamp(48px,6vw,72px);
    }
    .rire__card {
      padding: clamp(32px,3.5vw,44px) clamp(24px,3vw,32px);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: var(--radius);
      position: relative; overflow: hidden;
      transition: border-color .4s var(--ease), background .4s var(--ease);
    }
    .rire__card::before {
      content: ""; position: absolute; top: 0; left: 0;
      width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-2));
      transform: scaleX(0); transform-origin: left;
      transition: transform .45s var(--ease);
    }
    .rire__card:hover { border-color: var(--gold); }
    .rire__card:hover::before { transform: scaleX(1); }
    .rire__letter {
      display: block;
      font-family: var(--font-serif);
      font-size: 80px; font-weight: 300; line-height: 1;
      color: var(--gold); opacity: .35;
      letter-spacing: -0.04em; margin-bottom: 20px;
      transition: opacity .4s var(--ease);
    }
    .rire__card:hover .rire__letter { opacity: .7; }
    .rire__card h3 { font-size: 18px; font-weight: 700; color: var(--bg); margin: 0 0 10px; }
    .rire__card p { font-size: 14px; color: rgba(221,236,246,.5); margin: 0; line-height: 1.7; }
    @media (max-width: 900px) { .rire__grid { grid-template-columns: repeat(2,1fr); } }
    @media (max-width: 520px) { .rire__grid { grid-template-columns: 1fr; } }

    /* Équipe */
    .equipe { padding: clamp(80px,10vw,130px) 0; background: var(--bg); }
    .equipe__grid {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: clamp(16px,2vw,24px); margin-top: clamp(48px,6vw,72px);
    }
    .team-card {
      background: var(--paper);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      overflow: hidden;
      transition: transform .45s var(--ease), box-shadow .45s var(--ease), border-color .3s var(--ease);
    }
    .team-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); border-color: var(--gold); }
    .team-card__photo {
      aspect-ratio: 3/4; background: var(--bg-2);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    .team-card__photo img { width: 100%; height: 100%; object-fit: cover; }
    .team-card__initials {
      font-family: var(--font-serif);
      font-size: 52px; font-weight: 300;
      color: var(--gold); opacity: .6;
      letter-spacing: -0.03em;
    }
    .team-card__body { padding: 24px 24px 28px; }
    .team-card__name { font-size: 17px; font-weight: 700; margin: 0 0 4px; letter-spacing: -0.01em; }
    .team-card__role {
      font-size: 13px; color: var(--gold);
      font-weight: 600; text-transform: uppercase;
      letter-spacing: .06em; margin-bottom: 12px;
    }
    .team-card__bio { font-size: 13.5px; color: var(--muted); line-height: 1.65; margin: 0; }
    @media (max-width: 900px) { .equipe__grid { grid-template-columns: repeat(2,1fr); } }
    @media (max-width: 520px)  { .equipe__grid { grid-template-columns: 1fr; } }

    /* Stats bande */
    .about-stats {
      padding: clamp(64px,8vw,100px) 0;
      background: var(--bg-2);
    }
    .about-stats__grid {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 1px; background: var(--line);
      border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden;
    }
    .astat {
      background: var(--paper); padding: clamp(32px,4vw,48px) clamp(24px,3vw,36px);
      text-align: center;
    }
    .astat__num {
      display: block;
      font-family: var(--font-serif);
      font-size: clamp(44px,5.5vw,64px);
      font-weight: 300; color: var(--gold);
      letter-spacing: -0.04em; line-height: 1;
      margin-bottom: 10px;
    }
    .astat__label { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
    @media (max-width: 860px) { .about-stats__grid { grid-template-columns: repeat(2,1fr); } }
    @media (max-width: 480px) { .about-stats__grid { grid-template-columns: 1fr; } }

    /* CTA */
    .about-cta {
      padding: clamp(80px,10vw,130px) 0;
      background: var(--ink); text-align: center;
      position: relative; overflow: hidden;
    }
    .about-cta::before {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 60% at 50% 0%, rgba(201,162,95,.16) 0%, transparent 70%);
    }
    .about-cta__inner { position: relative; max-width: 660px; margin: 0 auto; }
    .about-cta h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px,5vw,56px); font-weight: 300;
      color: var(--bg); letter-spacing: -0.03em;
      margin: 0 0 20px; line-height: 1.1;
    }
    .about-cta h2 em { color: var(--gold-2); font-style: italic; }
    .about-cta p { color: rgba(221,236,246,.82); font-size: 17px; margin: 0 0 40px; line-height: 1.65; }
    .about-cta__btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .about-cta .btn--ghost { color: var(--bg); border-color: rgba(216,238,248,.35); }
    .about-cta .btn--ghost:hover { background: var(--bg); color: var(--ink); border-color: var(--bg); }

    /* ── Dark Mode Overrides ────────────────────────── */
    [data-theme="dark"] .about-hero { background: #060E18; }
    [data-theme="dark"] .about-hero h1 { color: var(--ink); }
    [data-theme="dark"] .about-hero__quote cite strong { color: var(--ink); }

    [data-theme="dark"] .mva { background: var(--bg); }
    [data-theme="dark"] .mva__card--mission { background: #060E18; color: var(--ink); }
    [data-theme="dark"] .mva__card--mission h3 { color: var(--ink); }
    [data-theme="dark"] .mva__card--mission p { color: rgba(221,236,246,.65); }
    [data-theme="dark"] .mva__card--vision { background: rgba(201,162,95,.12); }
    [data-theme="dark"] .mva__card--ambition { background: var(--paper); }

    [data-theme="dark"] .histoire { background: var(--bg-2); }
    [data-theme="dark"] .histoire__photo-badge { background: #060E18; color: var(--ink); }
    [data-theme="dark"] .histoire__step h3 { color: var(--ink); }

    [data-theme="dark"] .valeurs { background: #060E18; }
    [data-theme="dark"] .valeurs .section-title { color: var(--ink); }
    [data-theme="dark"] .valeurs .section-sub { color: rgba(221,236,246,.7); }
    [data-theme="dark"] .rire__card h3 { color: var(--ink); }
    [data-theme="dark"] .rire__card p { color: rgba(221,236,246,.5); }

    [data-theme="dark"] .equipe { background: var(--bg); }
    [data-theme="dark"] .about-stats { background: var(--bg-2); }
    [data-theme="dark"] .astat { background: var(--paper); }
    [data-theme="dark"] .astat__label { color: var(--muted); }

    [data-theme="dark"] .about-cta { background: #060E18; }
    [data-theme="dark"] .about-cta h2 { color: var(--ink); }
    [data-theme="dark"] .about-cta p { color: rgba(221,236,246,.75); }
  </style>
</head>
<body>

  <div class="cursor" id="cursor" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
  <div class="scroll-progress" aria-hidden="true"><span id="scrollBar"></span></div>

  <!-- Navigation -->
  <header class="nav" id="nav">
    <a href="index.html" class="nav__logo" aria-label="Global Impact Consulting - Accueil">
      <img src="assets/photo et logo/LOGO-GLOBAL-IMPACT-3-png.png" alt="Global Impact Consulting" height="40" style="display:block;height:40px;width:auto;" />
    </a>

    <nav class="nav__menu" id="navMenu" aria-label="Menu principal">
      <a href="qui-sommes-nous.html" data-nav style="color:var(--gold)">Qui sommes-nous</a>
      <a href="index.html#activities" data-nav>Nos activités</a>
      <a href="formation.html" data-nav>Formations</a>
      <a href="index.html#realisations" data-nav>Réalisations</a>
      <a href="index.html#faq" data-nav>FAQ</a>
      <a href="contact.html" data-nav class="nav__cta">Nous contacter <span aria-hidden="true">→</span></a>
    </nav>

    <button class="theme-toggle" id="themeToggle" aria-label="Basculer le mode sombre">
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>

    <button class="nav__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <main>

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-hero__bg" aria-hidden="true">
        <div class="blob blob--1"></div>
        <div class="blob blob--2"></div>
      </div>
      <div class="container">
        <div class="about-hero__inner">
          <div>
            <div class="eyebrow fade-up">
              <span class="dot"></span> Cabinet de formation · coaching · conseil
            </div>
            <h1 class="fade-up" style="--d:.06s">
              <%- blocks.hero_title_html %>
            </h1>
          </div>
          <blockquote class="about-hero__quote fade-up" style="--d:.14s">
            <p>« <%= blocks.hero_quote %> »</p>
            <cite>
              <strong><%= blocks.hero_quote_author %></strong>
              <span><%= blocks.hero_quote_role %></span>
            </cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- MISSION · VISION · AMBITION -->
    <section class="mva">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Notre raison d'être</span>
          <h2 class="section-title">Mission, vision & <em>ambition</em>.</h2>
          <p class="section-sub">Trois engagements qui définissent chaque intervention de Global Impact Consulting.</p>
        </div>

        <div class="mva__grid">

          <% var mvaMeta = [
            { cls: 'mission', icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>' },
            { cls: 'vision', icon: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>' },
            { cls: 'ambition', icon: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>' },
          ]; %>
          <% blocks.mva.forEach(function (m, i) { %>
            <div class="mva__card mva__card--<%= mvaMeta[i].cls %> reveal" style="--d:<%= (i * 0.08).toFixed(2) %>s">
              <div class="mva__icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- mvaMeta[i].icon %></svg>
              </div>
              <span class="mva__tag"><%= m.tag %></span>
              <h3><%= m.title %></h3>
              <p><%= m.text %></p>
            </div>
          <% }) %>

        </div>
      </div>
    </section>

    <!-- NOTRE HISTOIRE -->
    <section class="histoire">
      <div class="container">
        <div class="histoire__grid">

          <div>
            <figure class="histoire__photo reveal">
              <img src="assets/diversity-people-talk-international-conference-par-2026-03-18-12-01-06-utc.jpg" alt="Global Impact Consulting — séminaire et conférence" loading="lazy" decoding="async" />
              <div class="histoire__photo-badge">
                <strong><%= blocks.histoire_badge_num %></strong>
                <span><%= blocks.histoire_badge_label %></span>
              </div>
            </figure>
          </div>

          <div>
            <div class="section-head reveal" style="max-width:100%">
              <span class="section-kicker"><%= blocks.histoire_kicker %></span>
              <h2 class="section-title"><%- blocks.histoire_title_html %></h2>
              <p class="section-sub"><%= blocks.histoire_desc %></p>
            </div>

            <div class="histoire__timeline">
              <% historySteps.forEach(function (h, i) { %>
                <div class="histoire__step reveal" style="--d:<%= (0.05 + i * 0.07).toFixed(2) %>s">
                  <span class="histoire__year"><%= h.year_label %></span>
                  <div>
                    <h3><%= h.title %></h3>
                    <p><%= h.description %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- VALEURS RIRE -->
    <section class="valeurs">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Nos principes fondateurs</span>
          <h2 class="section-title">Les valeurs <em>RIRE</em>.</h2>
          <p class="section-sub">Quatre engagements qui guident chacune de nos actions et définissent notre posture professionnelle.</p>
        </div>

        <div class="rire__grid">
          <% blocks.valeurs.forEach(function (v, i) { %>
            <article class="rire__card reveal" style="--d:<%= (i * 0.08).toFixed(2) %>s">
              <span class="rire__letter"><%= v.letter %></span>
              <h3><%= v.title %></h3>
              <p><%= v.text %></p>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ÉQUIPE -->
    <section class="equipe">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Les visages de GIC</span>
          <h2 class="section-title">Notre <em>équipe</em>.</h2>
          <p class="section-sub">Des professionnels engagés, complémentaires et animés par une même conviction : que chaque personne et chaque organisation porte en elle un potentiel inexploité.</p>
        </div>

        <div class="equipe__grid">
          <% team.forEach(function (t, i) { %>
            <article class="team-card reveal" style="--d:<%= (i * 0.08).toFixed(2) %>s">
              <div class="team-card__photo">
                <img src="<%= t.photo %>" alt="<%= t.name %> — <%= t.role %>" loading="lazy" decoding="async" />
              </div>
              <div class="team-card__body">
                <p class="team-card__role"><%= t.role %></p>
                <h3 class="team-card__name"><%= t.name %></h3>
                <p class="team-card__bio"><%= t.bio %></p>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- CHIFFRES CLÉS -->
    <section class="about-stats">
      <div class="container">
        <div class="section-head reveal" style="text-align:center;max-width:600px;margin-left:auto;margin-right:auto;margin-bottom:clamp(40px,5vw,60px)">
          <span class="section-kicker">En chiffres</span>
          <h2 class="section-title">GIC en <em>quelques données</em>.</h2>
        </div>
        <div class="about-stats__grid reveal">
          <% blocks.stats.forEach(function (s) { %>
            <div class="astat">
              <span class="astat__num"><span data-count="<%= s.num %>">0</span><%= s.suffix %></span>
              <span class="astat__label"><%= s.label %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="about-cta">
      <div class="container">
        <div class="about-cta__inner">
          <h2><%- blocks.cta_title_html %></h2>
          <p><%= blocks.cta_text %></p>
          <div class="about-cta__btns">
            <a href="contact.html" class="btn btn--primary magnetic">
              <span>Nous contacter</span>
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="formation.html" class="btn btn--ghost magnetic">Voir les formations</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/site-footer', {
    navColumns: [
      { label: 'Navigation', ariaLabel: 'Navigation', links: [
        { href: 'qui-sommes-nous.html', text: 'Qui sommes-nous' },
        { href: 'index.html#activities', text: 'Nos activités' },
        { href: 'formation.html', text: 'Formations' },
        { href: 'index.html#realisations', text: 'Réalisations' },
        { href: 'index.html#faq', text: 'FAQ' },
      ]},
      { label: 'À propos', ariaLabel: 'À propos', links: [
        { href: 'qui-sommes-nous.html#mission', text: 'Mission & Vision' },
        { href: 'qui-sommes-nous.html#histoire', text: 'Notre histoire' },
        { href: 'qui-sommes-nous.html#valeurs', text: 'Valeurs RIRE' },
        { href: 'qui-sommes-nous.html#equipe', text: 'L\'équipe' },
      ]},
    ],
  }) %>

  <script src="script.js" defer></script>
</body>
</html>
