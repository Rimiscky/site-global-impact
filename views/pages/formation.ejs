  <script src="script.js" defer></script>
  <script>
    /* Domain bar active state on scroll */
    const domainLinks = document.querySelectorAll('.domain-link');
    const domainBlocks = document.querySelectorAll('.domain-block');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          domainLinks.forEach(l => l.classList.remove('active'));
          const active = document.querySelector(`.domain-link[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    domainBlocks.forEach(b => observer.observe(b));
  </script>
