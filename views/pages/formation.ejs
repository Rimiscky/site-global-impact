<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#184E6C" />

  <title>Formations — <%= settings.site_title %></title>
  <meta name="description" content="Découvrez les 49 programmes de formation GIC en Leadership, Management, Commercial, RH, QHSE et Développement personnel. Méthode G.I.M.P.A.C.T — 3 niveaux — 100 % sur mesure." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://globalimpactconsulting.com/formation.html" />

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23184E6C'/%3E%3Ctext x='50' y='64' font-family='Inter,Arial' font-size='44' font-weight='800' text-anchor='middle' fill='%23D4A574'%3EG%3C/text%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="styles.css" />

  <!-- Theme applied immediately to avoid flash -->
  <script>
    (function(){var t=localStorage.getItem('gic-theme'),d=t?t==='dark':window.matchMedia('(prefers-color-scheme: dark)').matches;if(d)document.documentElement.setAttribute('data-theme','dark');})();
  </script>

  <style>
    /* ── Page Formation extras ────────────────────────── */
    .formation-hero {
      padding: clamp(140px, 18vw, 200px) 0 clamp(80px, 10vw, 120px);
      background: var(--ink);
      position: relative;
      overflow: hidden;
    }
    .formation-hero__bg {
      position: absolute; inset: 0; pointer-events: none;
    }
    .formation-hero__bg .blob {
      position: absolute; border-radius: 50%; filter: blur(80px); opacity: .18;
    }
    .formation-hero__bg .blob--1 {
      width: 500px; height: 500px;
      background: var(--gold); top: -120px; right: -100px;
    }
    .formation-hero__bg .blob--2 {
      width: 340px; height: 340px;
      background: var(--gold-2); bottom: -60px; left: 10%;
    }
    .formation-hero .eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 13px; font-weight: 600; letter-spacing: .1em;
      text-transform: uppercase; color: var(--gold-2); margin-bottom: 28px;
    }
    .formation-hero .eyebrow .dot {
      width: 7px; height: 7px; border-radius: 50%; background: var(--gold);
    }
    .formation-hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(44px, 7vw, 88px);
      font-weight: 300; line-height: 1.05;
      letter-spacing: -0.03em; color: var(--bg);
      margin: 0 0 28px;
    }
    .formation-hero h1 em { color: var(--gold-2); font-style: italic; }
    .formation-hero__lead {
      color: rgba(221,236,246,.90);
      font-size: clamp(16px, 1.8vw, 19px);
      line-height: 1.7; max-width: 620px; margin: 0 0 48px;
    }
    .formation-hero__cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 64px; }
    .formation-hero__stats {
      display: flex; flex-wrap: wrap; gap: 40px;
      border-top: 1px solid rgba(255,255,255,.1);
      padding-top: 40px;
    }
    .formation-hero__stats .stat { min-width: 100px; }
    .formation-hero__stats .stat__num {
      display: block; font-family: var(--font-serif);
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 300; color: var(--gold-2);
      letter-spacing: -0.03em; line-height: 1;
    }
    .formation-hero__stats .stat__label {
      font-size: 13px; color: rgba(221,236,246,.5);
      text-transform: uppercase; letter-spacing: .08em; margin-top: 6px;
    }

    /* ── Domain intro bar ───────────────────────────── */
    .domains-bar {
      background: var(--paper);
      border-bottom: 1px solid var(--line-soft);
      position: sticky; top: 72px; z-index: 90;
    }
    .domains-bar .container {
      display: flex; align-items: center; gap: 0;
      overflow-x: auto; scrollbar-width: none;
    }
    .domains-bar .container::-webkit-scrollbar { display: none; }
    .domain-link {
      flex-shrink: 0; padding: 18px 22px;
      font-size: 14px; font-weight: 500; color: var(--muted);
      border-bottom: 2px solid transparent;
      transition: color .25s, border-color .25s;
      white-space: nowrap; cursor: pointer;
    }
    .domain-link.active,
    .domain-link:hover { color: var(--ink); border-color: var(--gold); }

    /* ── Programs section ───────────────────────────── */
    .programs { padding: clamp(64px, 8vw, 100px) 0; }
    .programs + .programs { padding-top: 0; }

    .domain-block { margin-bottom: clamp(64px, 8vw, 100px); }
    .domain-block__head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 20px; flex-wrap: wrap;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 36px;
    }
    .domain-block__num {
      font-family: var(--font-serif);
      font-size: 72px; font-weight: 300; line-height: 1;
      color: var(--gold); opacity: .25;
      letter-spacing: -0.04em;
    }
    .domain-block__info { flex: 1; }
    .domain-block__kicker {
      font-size: 12px; font-weight: 600;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 6px;
    }
    .domain-block__title {
      font-family: var(--font-serif);
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 400; letter-spacing: -0.02em; margin: 0;
    }
    .domain-block__count {
      font-size: 13px; color: var(--muted); margin-top: 6px;
    }

    /* ── Formation cards ────────────────────────────── */
    .fcards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: clamp(16px, 2vw, 24px);
    }
    .fcard {
      background: var(--paper);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      padding: 28px 28px 24px;
      display: flex; flex-direction: column; gap: 14px;
      position: relative; overflow: hidden;
      transition: transform .45s var(--ease), box-shadow .45s var(--ease), border-color .3s var(--ease);
    }
    .fcard::before {
      content: ""; position: absolute; top: 0; left: 0;
      width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-2));
      transform: scaleX(0); transform-origin: left;
      transition: transform .45s var(--ease);
    }
    .fcard:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--gold); }
    .fcard:hover::before { transform: scaleX(1); }

    .fcard__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .fcard__num {
      font-family: var(--font-serif); font-size: 13px;
      color: var(--gold); font-weight: 400;
    }
    .fcard__badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .badge {
      font-size: 10px; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; padding: 3px 9px;
      border-radius: 999px; border: 1px solid;
    }
    .badge--essentiel { color: #2E7D52; border-color: #2E7D52; background: #F0FAF4; }
    .badge--avance    { color: #9A6C00; border-color: var(--gold); background: var(--gold-soft); }
    .badge--executive { color: var(--ink); border-color: var(--ink); background: var(--bg-2); }

    .fcard h3 {
      font-size: 16px; font-weight: 700;
      letter-spacing: -0.01em; margin: 0; line-height: 1.35;
    }
    .fcard__desc { font-size: 13.5px; color: var(--muted); line-height: 1.65; margin: 0; flex: 1; }
    .fcard__meta {
      display: flex; align-items: center; gap: 16px;
      font-size: 12px; color: var(--muted);
      padding-top: 12px; border-top: 1px solid var(--line-soft);
      flex-wrap: wrap;
    }
    .fcard__meta span { display: flex; align-items: center; gap: 5px; }
    .fcard__meta svg { width: 13px; height: 13px; color: var(--gold); }
    .fcard__cta {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; font-weight: 600; color: var(--gold);
      margin-top: auto; transition: gap .25s var(--ease);
    }
    .fcard:hover .fcard__cta { gap: 10px; }

    /* ── Domain overview ──────────────────────────── */
    .domain-overview {
      padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 48px);
      background: var(--paper);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      position: relative; overflow: hidden;
    }
    .domain-overview::before {
      content: ""; position: absolute; top: 0; left: 0;
      width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-2));
    }
    .domain-overview__desc {
      font-size: clamp(15px, 1.6vw, 17px);
      line-height: 1.85;
      color: var(--muted);
      max-width: 820px;
      margin: 0 0 28px;
    }
    .domain-overview__themes {
      display: flex; flex-wrap: wrap; gap: 10px;
      list-style: none; padding: 0; margin: 0 0 36px;
    }
    .domain-overview__themes li {
      font-size: 13px; font-weight: 500;
      color: var(--ink);
      background: var(--gold-soft);
      border: 1px solid rgba(212,165,116,.35);
      padding: 7px 16px; border-radius: 999px;
      letter-spacing: .01em;
    }
    [data-theme="dark"] .domain-overview__themes li { color: var(--gold-2); }

    /* ── Methodology strip ──────────────────────────── */
    .method-strip {
      background: var(--ink); color: var(--bg);
      padding: clamp(64px, 8vw, 100px) 0;
    }
    .method-strip .section-title { color: var(--bg); }
    .method-strip .section-title em { color: var(--gold-2); }
    .method-strip .section-kicker { color: var(--gold-2); }
    .method-strip .section-sub { color: rgba(221,236,246,.6); }
    .method-strip .method__grid { margin-top: clamp(40px, 5vw, 60px); }
    .method-strip .method__card:not(.method__card--full) h3 { color: var(--ink); }
    .method-strip .method__card:not(.method__card--full) p { color: var(--muted); }

    /* ── Levels strip ───────────────────────────────── */
    .levels-strip {
      padding: clamp(64px, 8vw, 100px) 0;
      background: var(--ink);
      color: var(--bg);
    }
    .levels-strip .section-kicker { color: var(--gold-2); }
    .levels-strip .section-title { color: var(--bg); }
    .levels-strip .section-title em { color: var(--gold-2); font-style: italic; }
    .levels-strip .section-sub { color: rgba(221,236,246,.7); }

    /* ── CTA section ────────────────────────────────── */
    .formation-cta {
      padding: clamp(80px, 10vw, 130px) 0;
      background: var(--ink);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .formation-cta::before {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 60% at 50% 0%, rgba(201,162,95,.18) 0%, transparent 70%);
    }
    .formation-cta__inner { position: relative; max-width: 680px; margin: 0 auto; }
    .formation-cta h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 5vw, 56px);
      font-weight: 300; color: var(--bg);
      letter-spacing: -0.03em; margin: 0 0 20px;
      line-height: 1.1;
    }
    .formation-cta h2 em { color: var(--gold-2); font-style: italic; }
    .formation-cta p { color: rgba(221,236,246,.6); font-size: 17px; margin: 0 0 40px; }
    .formation-cta__btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .formation-hero .btn--ghost,
    .formation-cta .btn--ghost { color: var(--bg); border-color: rgba(216,238,248,.35); }
    .formation-hero .btn--ghost:hover,
    .formation-cta .btn--ghost:hover { background: var(--bg); color: var(--ink); border-color: var(--bg); }

    /* ── Dark Mode Overrides ────────────────────────── */
    [data-theme="dark"] .formation-hero {
      background: #060E18;
      color: var(--ink);
    }
    [data-theme="dark"] .formation-hero h1 { color: var(--ink); }
    [data-theme="dark"] .formation-hero__lead { color: rgba(221,236,246,.85); }

    /* Domain nav bar */
    [data-theme="dark"] .domains-bar {
      background: #0F2E42;
      border-bottom-color: rgba(221,236,246,.1);
    }
    [data-theme="dark"] .domain-link { color: rgba(221,236,246,.6); }
    [data-theme="dark"] .domain-link.active,
    [data-theme="dark"] .domain-link:hover { color: var(--gold-2); border-color: var(--gold); }

    /* Domain block header */
    [data-theme="dark"] .domain-block__head { border-bottom-color: rgba(221,236,246,.12); }
    [data-theme="dark"] .domain-block__title { color: var(--ink); }
    [data-theme="dark"] .domain-block__count { color: rgba(221,236,246,.65); }

    /* Domain overview card */
    [data-theme="dark"] .domain-overview {
      background: #0F2E42;
      border-color: rgba(221,236,246,.1);
    }
    [data-theme="dark"] .domain-overview__desc { color: rgba(221,236,246,.85); }
    [data-theme="dark"] .domain-overview__themes li {
      color: var(--gold-2);
      background: rgba(201,162,95,.18);
      border-color: rgba(201,162,95,.45);
    }

    /* Nav logo on dark hero (make image visible) */
    [data-theme="dark"] .nav:not(.is-scrolled) .nav__logo img {
      filter: brightness(0) invert(1);
      opacity: .9;
    }

    /* Levels & CTA */
    [data-theme="dark"] .levels-strip {
      background: #060E18;
      color: var(--ink);
    }
    [data-theme="dark"] .levels-strip .section-title { color: var(--ink); }
    [data-theme="dark"] .formation-cta {
      background: #060E18;
      color: var(--ink);
    }
    [data-theme="dark"] .formation-cta h2 { color: var(--ink); }
    [data-theme="dark"] .formation-cta p { color: rgba(221,236,246,.65); }
  </style>
</head>
<body>

  <!-- Custom cursor -->
  <div class="cursor" id="cursor" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

  <!-- Scroll progress -->
  <div class="scroll-progress" aria-hidden="true"><span id="scrollBar"></span></div>

  <!-- Navigation -->
  <header class="nav" id="nav">
    <a href="index.html" class="nav__logo" aria-label="Global Impact Consulting - Accueil">
      <img src="assets/photo et logo/LOGO-GLOBAL-IMPACT-3-png.png" alt="Global Impact Consulting" height="40" style="display:block;height:40px;width:auto;" />
    </a>

    <nav class="nav__menu" id="navMenu" aria-label="Menu principal">
      <a href="index.html#about" data-nav>Qui sommes-nous</a>
      <a href="index.html#activities" data-nav>Nos activités</a>
      <a href="formation.html" data-nav style="color:var(--gold)">Formations</a>
      <a href="index.html#levels" data-nav>Parcours</a>
      <a href="index.html#realisations" data-nav>Réalisations</a>
      <a href="index.html#faq" data-nav>FAQ</a>
      <a href="index.html#contact" data-nav class="nav__cta">Nous contacter <span aria-hidden="true">→</span></a>
    </nav>

    <button class="theme-toggle" id="themeToggle" aria-label="Basculer le mode sombre">
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>

    <button class="nav__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <main>

    <!-- HERO -->
    <section class="formation-hero">
      <div class="formation-hero__bg" aria-hidden="true">
        <div class="blob blob--1"></div>
        <div class="blob blob--2"></div>
      </div>
      <div class="container">
        <div class="eyebrow fade-up">
          <span class="dot"></span> Signature pédagogique G.I.M.P.A.C.T
        </div>
        <h1 class="fade-up" style="--d:.05s">
          Nos <em>formations</em><br>professionnelles.
        </h1>
        <p class="formation-hero__lead fade-up" style="--d:.12s">
          <%= blocks.hero_lead %>
        </p>
        <div class="formation-hero__cta fade-up" style="--d:.20s">
          <a href="#programmes" class="btn btn--primary magnetic">
            <span>Voir les programmes</span>
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="index.html#contact" class="btn btn--ghost magnetic">Demander un devis</a>
        </div>
        <div class="formation-hero__stats fade-up" style="--d:.30s">
          <div class="stat">
            <span class="stat__num" data-count="<%= totalPrograms %>">0</span>
            <span class="stat__label">Programmes</span>
          </div>
          <div class="stat">
            <span class="stat__num" data-count="<%= domains.length %>">0</span>
            <span class="stat__label">Domaines</span>
          </div>
          <div class="stat">
            <span class="stat__num" data-count="3">0</span>
            <span class="stat__label">Niveaux</span>
          </div>
          <div class="stat">
            <span class="stat__num"><span data-count="100">0</span>%</span>
            <span class="stat__label">Sur mesure</span>
          </div>
        </div>
      </div>
    </section>

    <!-- DOMAIN QUICK NAV -->
    <nav class="domains-bar" aria-label="Navigation par domaine">
      <div class="container">
        <% domains.forEach(function (d, i) { %>
          <a class="domain-link <%= i === 0 ? "active" : "" %>" href="#<%= d.slug %>"><%= d.name %></a>
        <% }) %>
      </div>
    </nav>

    <!-- PROGRAMMES -->
    <section class="programs" id="programmes">
      <div class="container">

        <% domains.forEach(function (d, i) { %>
          <div class="domain-block reveal" id="<%= d.slug %>">
            <div class="domain-block__head">
              <span class="domain-block__num" aria-hidden="true"><%= String(i + 1).padStart(2, "0") %></span>
              <div class="domain-block__info">
                <p class="domain-block__kicker"><%= d.kicker %></p>
                <h2 class="domain-block__title"><%= d.name %></h2>
                <p class="domain-block__count"><%= d.level_label %></p>
              </div>
            </div>
            <div class="domain-overview">
              <p class="domain-overview__desc"><%= d.description %></p>
              <ul class="domain-overview__themes" aria-label="Thèmes couverts">
                <% (programsByDomain[d.slug] || []).forEach(function (p) { %>
                  <li><%= p.title %></li>
                <% }) %>
              </ul>
              <a href="index.html#contact" class="btn btn--primary magnetic"><span>Demander un programme</span><svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        <% }) %>

      </div>
    </section>

    <!-- METHODOLOGY -->
    <section class="method-strip">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Notre approche</span>
          <h2 class="section-title">La méthodologie <em>G.I.M.P.A.C.T</em></h2>
          <p class="section-sub">Un parcours en 7 étapes conçu pour transformer la connaissance en résultat mesurable et durable.</p>
        </div>
        <div class="method__grid method__grid--strip">
          <article class="method__card reveal" style="--d:0s"><span class="method__letter">G</span><h3>Diagnostic Global</h3><p>Analyse du contexte réel du participant ou de l'organisation.</p></article>
          <article class="method__card reveal" style="--d:.06s"><span class="method__letter">I</span><h3>Immersion</h3><p>Compréhension des enjeux et partage d'expériences terrain.</p></article>
          <article class="method__card reveal" style="--d:.12s"><span class="method__letter">M</span><h3>Modélisation</h3><p>Apport méthodologique et outils structurants.</p></article>
          <article class="method__card reveal" style="--d:.18s"><span class="method__letter">P</span><h3>Pratique</h3><p>Ateliers, simulations et cas concrets.</p></article>
          <article class="method__card reveal" style="--d:.24s"><span class="method__letter">A</span><h3>Application</h3><p>Construction d'un plan d'action personnalisé.</p></article>
          <article class="method__card reveal" style="--d:.30s"><span class="method__letter">C</span><h3>Coaching</h3><p>Accompagnement post-formation continu.</p></article>
          <article class="method__card method__card--full reveal" style="--d:.36s"><span class="method__letter">T</span><h3>Transformation</h3><p>Mesure des résultats et impact organisationnel durable.</p></article>
        </div>
      </div>
    </section>

    <!-- LEVELS -->
    <section class="levels-strip">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-kicker">Parcours de formation</span>
          <h2 class="section-title">3 niveaux, <em>une progression</em> cohérente.</h2>
          <p class="section-sub">De l'acquisition des fondamentaux à la transformation stratégique — chaque programme est positionné selon votre profil.</p>
        </div>
        <div class="levels__grid">
          <article class="level reveal" style="--d:0s">
            <header>
              <span class="level__tag">Niveau 1</span>
              <h3>Essentiel</h3>
